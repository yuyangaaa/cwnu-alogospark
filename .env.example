# 网站端口
PORT=3000

# SMTP 邮件服务。以下是 465 端口的写法，请按邮箱服务商提供的信息修改。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 其他学校验证码安全限制（注册和邮箱验证码登录共用；计数保存在 SQLite 中）
EXTERNAL_CODE_TARGET_HOURLY_LIMIT=5
EXTERNAL_CODE_TARGET_DAILY_LIMIT=10
EXTERNAL_CODE_IP_15_MINUTE_LIMIT=20
EXTERNAL_CODE_IP_DAILY_LIMIT=50
# 本站 SMTP 发件箱总量熔断；协会官网验证码不计入这里
SMTP_HOURLY_LIMIT=60
SMTP_DAILY_LIMIT=300

# Cloudflare Turnstile 人机验证；两项都填写后自动在“其他学校注册”中启用
# 站点需先在 Cloudflare Turnstile 控制台登记当前域名
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 正式部署时取消下一行注释，并使用 HTTPS
# NODE_ENV=production

# 网站管理员邮箱，多个邮箱使用英文逗号分隔；只有这些已注册账号能看到管理后台
ADMIN_EMAILS=

# 西华师范大学计算机与算法协会官网登录接口
ASSOCIATION_AUTH_BASE_URL=https://www.cwnupaa.com/api
# 由协会官网管理员在“接口管理”中创建，只能保存在服务器 .env
ASSOCIATION_AUTH_APP_KEY=

# Hydro 对接（拿到管理员权限和 OJ 地址后填写）
# 这里可以填写域地址，例如 https://oj.example.com/d/association
HYDRO_BASE_URL=
# 判题桥插件地址。通常是在上面的域地址后追加 /algospark
HYDRO_BRIDGE_URL=
# 请换成至少 32 位的随机字符串；网站与未来的 Hydro 插件必须填写同一个值
HYDRO_WEBHOOK_SECRET=
# 本地开发默认显示接入演示题；不需要时设为 false
HYDRO_DEMO_MODE=true
